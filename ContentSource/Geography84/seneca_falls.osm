  <tag k="description" v="Bright cafe with unique coffee drinks, breakfast, lunch, brunch on Saturdays, wifi, and a couple of outlets at a few tables. Nice place to grab a drink/bite and chat, read or work. Themed after prominent women in the women's rights movement."/>
  <tag k="diet:vegetarian" v="yes"/>
  <tag k="internet_access" v="wlan"/>
  <tag k="internet_access:fee" v="no"/>
