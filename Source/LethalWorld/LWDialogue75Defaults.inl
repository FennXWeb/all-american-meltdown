{TEXT("companion_travel_56777c8d042c"),TEXT("companion_travel"),TEXT("I'll watch our backs. You pick the route.")},
{TEXT("companion_travel_8fa9f084c75b"),TEXT("companion_travel"),TEXT("Used to complain about traffic. Imagine that.")},
{TEXT("companion_travel_263979d7f26c"),TEXT("companion_travel"),TEXT("Check the corners. I'll check the windows.")},
{TEXT("companion_travel_2f85495ff8f3"),TEXT("companion_travel"),TEXT("If we find coffee, I'm calling that a victory.")},
{TEXT("companion_travel_425a8bb06345"),TEXT("companion_travel"),TEXT("There's still good stuff out here. Just takes looking.")},
{TEXT("companion_travel_497874d7a986"),TEXT("companion_travel"),TEXT("Let me know if you need a breather.")},
{TEXT("companion_travel_08b44daab206"),TEXT("companion_travel"),TEXT("I'd rather walk with you than sit worrying at home.")},
{TEXT("companion_travel_4f826cedba0f"),TEXT("companion_travel"),TEXT("Keep a little water in reserve. Learned that the hard way.")},
{TEXT("companion_travel_44505eeb7cf9"),TEXT("companion_travel"),TEXT("Funny what survives. Street signs outlasted the country.")},
{TEXT("companion_travel_7f00faa40b67"),TEXT("companion_travel"),TEXT("We should mark a way back before we go too far.")},
{TEXT("companion_travel_b6e0b1400f42"),TEXT("companion_travel"),TEXT("I miss hearing somebody mow their lawn.")},
{TEXT("companion_travel_8c920e14b1e8"),TEXT("companion_travel"),TEXT("One decent meal and a dry bed. That's the dream.")},
{TEXT("companion_combat_45cd74d39313"),TEXT("companion_combat"),TEXT("Contact! Stay behind something solid!")},
{TEXT("companion_combat_983ca6cf5098"),TEXT("companion_combat"),TEXT("I've got this angle. Watch your side!")},
{TEXT("companion_combat_794c514d4d2a"),TEXT("companion_combat"),TEXT("Don't rush them. Make them come to us!")},
{TEXT("companion_combat_ea52562994ac"),TEXT("companion_combat"),TEXT("Still fighting! Stay with me!")},
{TEXT("companion_combat_89cb2246c732"),TEXT("companion_combat"),TEXT("Keep your head down. I'm here!")},
{TEXT("companion_combat_a04f05caa1d3"),TEXT("companion_combat"),TEXT("We can get through this. Keep moving!")},
{TEXT("companion_hurt_ca28dba79f7e"),TEXT("companion_hurt"),TEXT("I'm bleeding. Could use a moment.")},
{TEXT("companion_hurt_9e47ecb4e344"),TEXT("companion_hurt"),TEXT("That one got me. Don't go too far.")},
{TEXT("companion_hurt_0fcd00e83376"),TEXT("companion_hurt"),TEXT("Still standing. Barely.")},
{TEXT("companion_rain_208c26d64f94"),TEXT("companion_rain"),TEXT("So much for keeping my socks dry.")},
{TEXT("companion_rain_715a1384bd79"),TEXT("companion_rain"),TEXT("Rain's covering our footsteps. Their footsteps too.")},
{TEXT("companion_rain_4e143f9e27ad"),TEXT("companion_rain"),TEXT("Next roof we find, let's take a minute.")},
{TEXT("companion_night_9b82839434c4"),TEXT("companion_night"),TEXT("Can't see much out there. Listen carefully.")},
{TEXT("companion_night_a196bb79ca12"),TEXT("companion_night"),TEXT("Never liked walking these roads after dark.")},
{TEXT("companion_night_1edbd66054f0"),TEXT("companion_night"),TEXT("A few hours until daylight. We can manage.")},
{TEXT("companion_vehicle_b001d32fbbe3"),TEXT("companion_vehicle"),TEXT("Nice to let something else do the walking.")},
{TEXT("companion_vehicle_1d54613c29d4"),TEXT("companion_vehicle"),TEXT("I'll keep an eye out through the window.")},
{TEXT("companion_vehicle_89cf90380c66"),TEXT("companion_vehicle"),TEXT("A seat and a roof. We're moving up in the world.")},
{TEXT("settler_idle_6388c6863b1c"),TEXT("settler_idle"),TEXT("Morning or night, there's always something to mend.")},
{TEXT("settler_idle_2120dd58a700"),TEXT("settler_idle"),TEXT("If you find seeds out there, don't throw them away.")},
{TEXT("settler_idle_6c813f135b87"),TEXT("settler_idle"),TEXT("Been patching that same coat for years.")},
{TEXT("settler_idle_b335ad3218e8"),TEXT("settler_idle"),TEXT("I still catch myself checking the mailbox.")},
{TEXT("settler_idle_f3017399b9d7"),TEXT("settler_idle"),TEXT("Nobody here gets through this alone.")},
{TEXT("settler_idle_2667efa5ef98"),TEXT("settler_idle"),TEXT("Wish I knew a recipe that didn't start with a tin.")},
{TEXT("settler_idle_d1a8cbe9dd6d"),TEXT("settler_idle"),TEXT("You learn to appreciate a quiet day.")},
{TEXT("settler_idle_cc1ccf1f163d"),TEXT("settler_idle"),TEXT("Take care on the roads, stranger.")},
{TEXT("settler_idle_e0a2374fb638"),TEXT("settler_idle"),TEXT("Got to keep busy. Helps with everything else.")},
{TEXT("settler_idle_560eb0d5ab90"),TEXT("settler_idle"),TEXT("Someone ought to write all this down.")},
{TEXT("settler_idle_9115a7689ca1"),TEXT("settler_idle"),TEXT("I'm saving up for a proper pair of boots.")},
{TEXT("settler_idle_fd9e1bfc5154"),TEXT("settler_idle"),TEXT("A garden would make this place feel like home.")},
{TEXT("settler_idle_4009a9f8c931"),TEXT("settler_idle"),TEXT("Never thought I'd miss paying rent.")},
{TEXT("settler_idle_44101f14fb85"),TEXT("settler_idle"),TEXT("If a hinge squeaks, oil it. Don't wake the whole street.")},
{TEXT("settler_idle_a6aa6bfea15b"),TEXT("settler_idle"),TEXT("Good to see another living face.")},
{TEXT("settler_merchant_1091f34934d5"),TEXT("settler_merchant"),TEXT("Have a look. Something here might keep you alive.")},
{TEXT("settler_merchant_320ae35a92f7"),TEXT("settler_merchant"),TEXT("Buying or selling? I can do either.")},
{TEXT("settler_merchant_82a81a411ae5"),TEXT("settler_merchant"),TEXT("Don't need it yourself? Somebody else probably does.")},
{TEXT("settler_warden_39ee7967719b"),TEXT("settler_warden"),TEXT("Need work? Take a look at the contracts.")},
{TEXT("settler_warden_2396e5d3a7d9"),TEXT("settler_warden"),TEXT("Always jobs to do around here.")},
{TEXT("settler_warden_5a5ea3210891"),TEXT("settler_warden"),TEXT("Bring back supplies and we'll make it worth your while.")},
{TEXT("settler_medic_21bf461c43bb"),TEXT("settler_medic"),TEXT("Keep that wound clean. Dirt's as dangerous as bullets.")},
{TEXT("settler_medic_1da6b0c86f3a"),TEXT("settler_medic"),TEXT("If you're hurt, come see me before it gets worse.")},
{TEXT("settler_medic_fa25770feabe"),TEXT("settler_medic"),TEXT("Clean water and clean bandages. Can't have too many.")},
{TEXT("settler_canada_17361ec20c0e"),TEXT("settler_canada"),TEXT("Welcome to Toronto. Hope you enjoy your stay.")},
{TEXT("settler_canada_86e657893336"),TEXT("settler_canada"),TEXT("The shops take Canadian dollars. Try the exchange first.")},
{TEXT("settler_canada_cccb81f303ed"),TEXT("settler_canada"),TEXT("Plenty to see around here. Take your time.")},
{TEXT("settler_alarm_8cf7148b7186"),TEXT("settler_alarm"),TEXT("Trouble! Get everyone inside!")},
{TEXT("settler_alarm_64bbcc52068b"),TEXT("settler_alarm"),TEXT("Find cover! Protect the town!")},
{TEXT("settler_alarm_12bc079fcf89"),TEXT("settler_alarm"),TEXT("Stay away from the windows!")},
{TEXT("raider_combat_20df84e121f5"),TEXT("raider_combat"),TEXT("There! Keep shooting!")},
{TEXT("raider_combat_c97b6bbf1466"),TEXT("raider_combat"),TEXT("You're not walking out of this!")},
{TEXT("raider_combat_7944a876e0f1"),TEXT("raider_combat"),TEXT("Come on! Show yourself!")},
