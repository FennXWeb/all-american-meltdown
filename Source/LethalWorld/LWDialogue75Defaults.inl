{TEXT("raider_combat_1714cf881737"),TEXT("raider_combat"),TEXT("Don't give them room!")},
{TEXT("raider_combat_61536b724df7"),TEXT("raider_combat"),TEXT("Picked a bad place to wander!")},
{TEXT("raider_search_51afe4926a35"),TEXT("raider_search"),TEXT("Where'd you go?")},
{TEXT("raider_search_a280ce0bb89c"),TEXT("raider_search"),TEXT("Keep looking. They're close.")},
{TEXT("raider_search_93a12f1b394c"),TEXT("raider_search"),TEXT("Check behind that cover!")},
{TEXT("raider_search_adac89b570f8"),TEXT("raider_search"),TEXT("Stay sharp. I lost sight of them.")},
{TEXT("raider_search_f52b66b52455"),TEXT("raider_search"),TEXT("I know you're still here!")},
{TEXT("raider_search_aea621873c0c"),TEXT("raider_search"),TEXT("Watch the exits!")},
{TEXT("raider_reload_52a275cd79f3"),TEXT("raider_reload"),TEXT("Reloading! Keep them back!")},
