 Add(TEXT("boarding and chauffeur"),1,[this,S](ALWCharacter& P){auto* C=S->Car.Get();if(!C)return;C->ChangeSeat(3);P.SeatYaw=P.SeatPitch=0;P.SetWaypoint(FVector2D(C->GetActorLocation())+FVector2D(4000,0));auto* N=GetWorld()->SpawnActor<ALWResident>(C->GetActorLocation()+FVector(0,-260,100),FRotator::ZeroRotator);S->NPC=N;N->ConfigureResident(TEXT("v14_crew"),TEXT("recruit"),TEXT("MORGAN"),0);FLWCrewRecord Crew;Crew.Id=N->ResidentId;Crew.Following=true;P.RPG.Crew.Add(Crew);Check(C->Board(N),TEXT("companion enters driver seat"));Check(C->Chauffeur==N&&N->SeatIndex==-1,TEXT("driver seat ownership"));S->Start=C->GetActorLocation();},[this,S](ALWCharacter& P){if(S->Car.IsValid()){Check(S->Car->AutoDriving,TEXT("driver starts after boarding"));CaptureV2(TEXT("CompanionDriverV14"));}});
