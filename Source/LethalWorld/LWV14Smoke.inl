 Add(TEXT("RV model and cabin"),1,[this,S](ALWCharacter& P){P.ClosePanels();P.bSafehouse=false;LWV2Teleport(P,FVector(0,3000,130));FName Id(TEXT("v14_camper"));FLWVehicleRecord R;R.Model=TEXT("rv");R.VIN=FGuid::NewGuid();R.Position=FVector(0,3600,P.World->HeightAt(FVector2D(0,3600))+75);R.Unlocked=R.Hotwired=true;P.World->Vehicles.Add(Id,R);auto* C=Cast<ALWVehicle>(P.World->SpawnObject(ELWObjectKind::Car,Id,R.Position));S->Car=C;if(!RequireV2(C!=nullptr,TEXT("RV spawned")))return;Check(C->Spec().Seats==5,TEXT("RV five seats"));Check(C->Body->GetStaticMesh()==P.World->Mesh(TEXT("CamperShellV17")),TEXT("RV uses new shell"));int Seats=0;TSet<FName> Controls;for(UStaticMeshComponent* M:C->Details){if(M->GetStaticMesh()==P.World->Mesh(TEXT("CamperSeatV14")))Seats++;for(auto Tag:M->ComponentTags)Controls.Add(Tag);}Check(Seats==5,TEXT("driver chair plus four camper passenger chairs"));for(FName Tag:{FName(TEXT("bed")),FName(TEXT("cooker")),FName(TEXT("sink")),FName(TEXT("fridge")),FName(TEXT("pantry")),FName(TEXT("wardrobe"))})Check(Controls.Contains(Tag),TEXT("habitation fixture interactable"));LWV2Teleport(P,R.Position+FVector(550,-820,130));P.Controller->SetControlRotation((R.Position+FVector(0,0,100)-P.Camera->GetComponentLocation()).Rotation());},[this](ALWCharacter&){CaptureV2(TEXT("CamperExteriorV14"));});
