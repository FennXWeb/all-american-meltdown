 Add(TEXT("weapon attachments and rarity"),3,[this,S](ALWCharacter& P){P.Inventory.Empty();auto G=LWItems::Make(TEXT("rifle"));G.Slot=TEXT("Primary");G.WeaponTier=3;G.Attachments.Add(TEXT("Optic"),TEXT("att_scope4"));G.Attachments.Add(TEXT("Light"),TEXT("att_light"));G.Attachments.Add(TEXT("Laser"),TEXT("att_laser"));G.Attachments.Add(TEXT("Grip"),TEXT("att_vertical"));P.Inventory.Add(G);S->Gun=G.Id;P.ActiveWeaponId=G.Id;P.Equip(6);Check(P.AttachmentParts.Num()==4,TEXT("four visible mounted components"));for(UStaticMeshComponent* C:P.AttachmentParts)Check(C&&C->GetStaticMesh()&&C->GetAttachParent()==P.WeaponMesh,TEXT("attachment mesh exists and follows gun"));Check(P.GunLight&&P.LaserDot,TEXT("working mounted light and laser components"));P.Controller->SetControlRotation(FRotator(0,0,0));},[this](ALWCharacter&){CaptureV2(TEXT("RifleAttachmentsV14"));});
