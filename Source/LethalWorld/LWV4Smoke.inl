 auto Resident=[](ALWCharacter& P,FName Job,int Index=0)->ALWResident*{for(TActorIterator<ALWResident> I(P.GetWorld());I;++I)if(I->NpcRole==Job){if(Index--==0)return *I;}return nullptr;};
