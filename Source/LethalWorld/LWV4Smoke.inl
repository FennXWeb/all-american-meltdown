 Add(TEXT("v4 assets and settlement"),3,[](ALWCharacter& P){P.NewGame();P.Money=2000;const FVector At(LWGen::Hub(FIntPoint::ZeroValue,P.World->Seed)+FVector2D(0,-5000),115);P.World->Stream(At,true);LWV2Teleport(P,At+FVector(0,-1000,0));P.Controller->SetControlRotation(FRotator(0,90,0));},[this,Resident](ALWCharacter& P){
