 Add(TEXT("hire default squad and excess recruit"),2,[this,Meet,State](ALWCharacter& P){auto* A=Meet(P,TEXT("recruit"));if(!RequireV2(A!=nullptr,TEXT("first recruit available")))return;State->CrewA=A->ResidentId;State->Companion=A;Check(P.Recruit(A),TEXT("first companion hired"));Check(!P.Recruit(A),TEXT("duplicate recruitment rejected"));auto* B=Meet(P,TEXT("recruit"),1);if(!RequireV2(B!=nullptr,TEXT("second recruit available")))return;State->CrewB=B->ResidentId;Check(P.Recruit(B),TEXT("excess recruit hired into bunker"));P.ClosePanels();Check(P.RPG.Crew.Num()==2&&P.RPG.Crew[0].Following&&!P.RPG.Crew[1].Following,TEXT("default capacity enforced"));Check(!P.SetCompanion(State->CrewB,true),TEXT("cannot exceed squad limit"));},[this,State](ALWCharacter& P){
