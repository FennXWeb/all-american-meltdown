 Add(TEXT("service room capture"),1,[](ALWCharacter& P){LWV2Teleport(P,FVector(-3100,2900,-1870));P.Controller->SetControlRotation(FRotator(-10,15,0));},[this](ALWCharacter& P){CaptureV2(TEXT("10_Workshop"));});
