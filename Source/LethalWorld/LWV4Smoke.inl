  int Bedrooms=0;TSet<int> RoomIDs;for(AActor* A:P.World->BunkerParts)if(auto* D=Cast<ALWWorldObject>(A))if(D->RecordId.ToString().StartsWith(TEXT("bedroom_door_")))Bedrooms++;
  Check(Bedrooms==10,TEXT("ten private bedrooms have actual doors"));for(int I=0;I<10;I++){const FVector At=P.World->BedroomPosition(I);Check(ALWWorld::IsSafePosition(At),TEXT("bedroom lies inside protected volume"));FHitResult Floor;Check(GetWorld()->LineTraceSingleByChannel(Floor,At,At-FVector(0,0,220),ECC_Visibility),TEXT("bedroom has solid floor"));}
