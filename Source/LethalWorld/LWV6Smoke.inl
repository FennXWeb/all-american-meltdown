  FName Id=TEXT("v6_tools_box");FLWContainerRecord R;R.Id=Id;R.Position=P.GetActorLocation()+FVector(80,0,-90);auto Water=LWItems::Make(TEXT("water"),2);LWItems::Place(R.Items,Water,12,12);S->Water=Water.Id;P.World->Containers.Add(Id,R);S->Box=P.World->SpawnObject(ELWObjectKind::Container,Id,R.Position);P.OpenContainer(S->Box.Get());S->Count=P.CountSupply(TEXT("water"));Cast<APlayerController>(P.Controller)->SetMouseLocation(820,160);
 });
