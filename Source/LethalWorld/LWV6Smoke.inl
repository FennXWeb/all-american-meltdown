 auto Add=[this](const TCHAR* N,double W,FLWV2Action B,FLWV2Action E=FLWV2Action()){V2->Steps.Add({N,W,25,MoveTemp(B),MoveTemp(E),FLWV2Ready()});};
 struct FState{TWeakObjectPtr<ALWWorldObject> Box;TWeakObjectPtr<ALWVehicle> Car;TWeakObjectPtr<ALWResident> Citizen;TArray<TWeakObjectPtr<ALWResident>> Crew;FVector At;FGuid Water;int Count;};auto S=MakeShared<FState>();
