 },[this,S](ALWCharacter& P){int Seated=0;TSet<int> Seats;for(auto N:S->Crew)if(N->Riding){Seated++;Seats.Add(N->SeatIndex);Check(N->GetCapsuleComponent()->GetCollisionEnabled()==ECollisionEnabled::NoCollision,TEXT("passenger cannot block chassis"));}Check(Seated==3&&Seats.Num()==3,TEXT("three distinct passenger seats filled without duplication"));Check(S->Crew.ContainsByPredicate([](auto N){return !N->Riding;}),TEXT("fourth companion remains on foot"));CaptureV2(TEXT("V6_Passengers"));});
 Add(TEXT("occupied car drives on raised asphalt"),2,[this,S,Key](ALWCharacter& P){P.SeatYaw=P.SeatPitch=0;S->At=S->Car->GetActorLocation();S->Car->Ignition();Key(P,EKeys::W,true);},[this,S,Key](ALWCharacter& P){Check(FVector::Dist2D(S->At,S->Car->GetActorLocation())>200,TEXT("fully occupied car drives without passenger or road penetration blocking it"));Key(P,EKeys::W,false);P.Forward(0);S->Car->Speed=0;
  for(auto N:S->Crew)if(!N->Riding){N->SetActorLocation(S->Car->GetActorLocation()+FVector(14000,0,0));N->TickSocial(8.1f,&P,true,3);Check(!P.RPG.Crew.FindByPredicate([&](const auto& C){return C.Id==N->ResidentId;})->Following,TEXT("outpaced companion removed from active squad"));Check(ALWWorld::IsSafePosition(N->GetActorLocation()),TEXT("outpaced companion returns to bunker"));}
  Check(S->Car->Exit(),TEXT("driver and passengers exit safely"));for(auto N:S->Crew)Check(!N->Riding,TEXT("passenger detaches on driver exit"));
 });
