 Add(TEXT("shared tab navigation"),.5,[this,S](ALWCharacter& P){auto* H=Cast<ALWHUD>(Cast<APlayerController>(P.Controller)->GetHUD());for(int I=1;I<5;I++){H->NotifyHitBoxClick(FName(*FString::Printf(TEXT("tab_%d"),I)));Check(!P.CanAct()&&(I==1?P.bMap:P.RPGPanel==I-1),TEXT("tabs switch panel and retain input gating"));}H->NotifyHitBoxClick(TEXT("tab_0"));Check(P.bInventory&&P.OpenObject==S->Box.Get()&&P.ItemsFor(2),TEXT("returning to inventory retains nearby container"));H->NotifyHitBoxClick(TEXT("tab_2"));},[this](ALWCharacter&){CaptureV2(TEXT("V6_SkillsTabs"));});
 Add(TEXT("settlement activity"),3,[this,S](ALWCharacter& P){P.ClosePanels();const FVector At(LWGen::Hub(FIntPoint::ZeroValue,P.World->Seed)+FVector2D(0,-5000),115);LWV2Teleport(P,At+FVector(0,-1400,0));P.World->Stream(At,true);P.Controller->SetControlRotation(FRotator(-5,90,0));int Civ=0;for(TActorIterator<ALWResident> N(GetWorld());N;++N)if(N->NpcRole==TEXT("civilian")&&FVector::Dist2D(N->GetActorLocation(),At)<5000){Civ++;S->Citizen=*N;}Check(Civ>=6,TEXT("settlement has six ambient residents"));if(!RequireV2(S->Citizen.IsValid(),TEXT("citizen fixture present")))return;auto* N=S->Citizen.Get();N->ActivitySpots={N->GetActorLocation()+FVector(0,450,0)};N->Activity=0;N->ActivityTime=10;S->At=N->GetActorLocation();N->Say(TEXT("Someone fixed the water pump."));P.Talk(N);Check(P.RPGPanel==0&&!P.Speaker,TEXT("ambient resident cannot open a conversation"));},[this,S](ALWCharacter&){Check(FVector::Dist2D(S->At,S->Citizen->GetActorLocation())>40,TEXT("ambient resident walks between activities"));CaptureV2(TEXT("V6_Settlement"));});
 Add(TEXT("companion passenger seating"),1,[this,S](ALWCharacter& P){P.ClosePanels();LWV2Teleport(P,FVector(2000,-300,115));P.World->Stream(P.GetActorLocation(),true);P.RPG.Crew.Empty();P.RPG.Attributes[3]=10;P.RPG.Perks.Add(TEXT("perk_23"),3);
  FLWVehicleRecord Sedan;Sedan.Model=TEXT("sedan");Sedan.VIN=FGuid::NewDeterministicGuid(TEXT("v6_car"));Sedan.Position=FVector(2000,0,75);P.World->Vehicles.Add(TEXT("v6_car"),Sedan);S->Car=Cast<ALWVehicle>(P.World->SpawnObject(ELWObjectKind::Car,TEXT("v6_car"),FVector(2000,0,85)));if(!RequireV2(S->Car.IsValid(),TEXT("vehicle fixture created")))return;S->Car->Record()->Unlocked=true;S->Car->Record()->Hotwired=true;
  for(int I=0;I<4;I++){FLWCrewRecord C;C.Id=FName(*FString::Printf(TEXT("v6_crew_%d"),I));C.Name=FString::Printf(TEXT("CREW %d"),I);C.Following=true;C.Bedroom=I;P.RPG.Crew.Add(C);auto* N=GetWorld()->SpawnActor<ALWResident>(FVector(1800+I*80,240,110),FRotator::ZeroRotator);N->ConfigureResident(C.Id,TEXT("recruit"),C.Name,I);S->Crew.Add(N);}
