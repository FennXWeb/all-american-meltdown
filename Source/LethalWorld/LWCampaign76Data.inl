S.Beats.Add({TEXT("keene"),TEXT("Marshal Adrian Keene. Restoration Directorate. Do not mind the seals: the medicine inside is current, and the clinic can test a dose before signing anything."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mercer"),TEXT("The northern referral has a space for every household member, including dependents. Registration is not a guarantee of a seat."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("keene"),TEXT("We need an accurate survey around Bellwether: trades, relatives, chronic conditions. We cannot plan with guesses. In return, your clinic gets antibiotics and you get a named contact on the northern road."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("lena"),TEXT("Who receives the household sheet after you?"),{TEXT("!dead_lena")},TEXT("point"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mercer"),TEXT("The transfer office. The copy stays here until the next dispatch. Names and skills can determine placement. Read that part before you agree."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Explain what registration means."),TEXT("aid_questions"),TEXT(""),{},{}});
S.Choices.Add({TEXT("Supply accurate household records."),TEXT("aid_accept"),TEXT("housing_visit"),{},{TEXT("registration=1"),TEXT("aid_received"),TEXT("give:medkit:2"),TEXT("trust_keene+=1"),TEXT("journal:Keene supplied medicine for Bellwether's household survey. The duplicate remains at the municipal office until dispatch.")}});
S.Choices.Add({TEXT("Submit a falsified survey that omits residents and skills."),TEXT("aid_false"),TEXT("housing_visit"),{},{TEXT("registration=2"),TEXT("aid_received"),TEXT("give:medkit:2"),TEXT("directorate_suspicion+=1")}});
S.Choices.Add({TEXT("Refuse the survey. Keep people off the register."),TEXT("aid_refuse"),TEXT("housing_visit"),{},{TEXT("registration=3")}});
S.Choices.Add({TEXT("Offer to check the duplicate records before deciding."),TEXT("aid_investigate"),TEXT("aid_records"),{},{TEXT("registration=4")}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("aid_questions");S.Next=TEXT("");
S.Beats.Add({TEXT("keene"),TEXT("It means a location, a head count, and somebody responsible for correcting it. Some trades are urgently needed. Families move together where possible."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mercer"),TEXT("Where possible is not a promise. You can inspect your duplicate or withdraw it here before dispatch."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("keene"),TEXT("June is right. If you know a cleaner way to deliver medicine across three counties, bring it to me. Until then, we will use lists."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Return to the offer."),TEXT("aid_intro"),TEXT(""),{},{}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("aid_accept");S.Next=TEXT("");
S.Beats.Add({TEXT("mercer"),TEXT("Sign below the household count. Keep this receipt. The red duplicate is the one to correct if anything is wrong."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("keene"),TEXT("You will find the antibiotics do more good than the argument about who sent them. I hope we can keep it that way."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("aid_false");S.Next=TEXT("");
S.Beats.Add({TEXT("mercer"),TEXT("This is unusually sparse. I will mark it provisional. The transport office may ask to verify it."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("keene"),TEXT("Provisional is better than nothing. June, release the clinic pack."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("aid_refuse");S.Next=TEXT("");
S.Beats.Add({TEXT("keene"),TEXT("That is your decision. The package is tied to the survey; I cannot keep making private exceptions."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mercer"),TEXT("The market clinic can still refer patients through Northbank. Ask Samir. Humanitarian intake is not ours to deny."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("aid_investigate");S.Next=TEXT("");
S.Beats.Add({TEXT("mercer"),TEXT("Duplicates are in the side office. Read only what the household authorized. If a name is missing, bring me a case number."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("keene"),TEXT("Accuracy is the point. If you find a mistake, I want it on paper."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("duplicates");S.Next=TEXT("housing_visit");
S.Beats.Add({TEXT(""),TEXT("DUPLICATE 14 / TOMAS PAREDES / water technician. Dependents: Elena Paredes, spouse; Luis Paredes, child. Destination on applicant copy: FAMILY HOUSING. Destination on dispatch carbon: PROCESSING / SEPARATE TRANSPORT."),{},TEXT(""),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT(""),TEXT("The carbon is dated two days before the housing inspection was signed. A marginal note reads: retain trade classification; no forwarding address."),{},TEXT(""),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mercer"),TEXT("That is not a typo I can fix at this desk. Elena still lives at the listed address. She came here yesterday asking where they took her husband."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("elena_intro");S.Next=TEXT("housing_search");
S.Beats.Add({TEXT("elena"),TEXT("If you are here for the rest of the house, go away. They already measured the kitchen."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mara"),TEXT("We are not taking anything. Samir sent us."),{TEXT("!dead_mara")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("elena"),TEXT("Tomas repaired water pumps. They offered us housing where the pipes worked. The transport came for him first. They said Luis and I would follow."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("elena"),TEXT("He left his wedding ring because the pump casings catch it. It is not a clue he planted. It is just what he always did."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),1.4f});
S.Beats.Add({TEXT("elena"),TEXT("The driver asked me to pack our documents separately. Tomas made a rubbing of the cargo tag while they waited. It is on the kitchen table. Please find an address, not a rumor."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("cargo_tag");S.Next=TEXT("records_remedy");
S.Beats.Add({TEXT(""),TEXT("A pencil rubbing: ROME FREIGHT / TRANSFER 14 / RETAIN TECHNICIAN. Beneath it, Tomas wrote: ask D. Voss at canal terminal if the housing office loses us."),{},TEXT(""),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("elena"),TEXT("Della knew him before any of this. He helped her get the old pumps turning. If she has seen that tag, she will know where it went."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("elena"),TEXT("Take the family photograph, if you need it. Leave the ring. I need one thing to stay where he left it."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("remedy");S.Next=TEXT("");
S.Beats.Add({TEXT("mercer"),TEXT("I checked transfer fourteen. The transport office will not give me a forwarding address. They say the family is not authorized to ask."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mercer"),TEXT("Your Bellwether duplicate is still here. I warned you about placement. I did not understand it could mean this."),{TEXT("registration=1")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mercer"),TEXT("Your provisional survey has not been verified. I can still withdraw it."),{TEXT("registration=2")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mercer"),TEXT("There is no Bellwether submission from you. There are still other families on these sheets."),{TEXT("registration>=3")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mercer"),TEXT("If you take the dispatch carbon, people can compare the two destinations. If you burn every copy, fewer names leave this room, but so does part of the trail. Decide while the courier is away."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Take the carbon; withdraw my survey and hide the dependent addresses."),TEXT("remedy_protect"),TEXT(""),{},{TEXT("records_recovered"),TEXT("registration_withdrawn"),TEXT("evidence_transfer"),TEXT("trust_mercer+=2"),TEXT("journal:June withdrew the Bellwether survey. I retained the conflicting transfer carbon without the dependent addresses.")}});
S.Choices.Add({TEXT("Destroy the dispatch bundle so these families cannot be traced from it."),TEXT("remedy_destroy"),TEXT(""),{},{TEXT("records_destroyed"),TEXT("registration_withdrawn"),TEXT("evidence_transfer=0"),TEXT("trust_mercer+=1"),TEXT("journal:The dispatch bundle was destroyed. Elena's rubbing remains an alternate lead to Rome.")}});
S.Choices.Add({TEXT("Keep the evidence, but leave registration active to maintain access."),TEXT("remedy_keep"),TEXT(""),{},{TEXT("evidence_transfer"),TEXT("registration_active"),TEXT("leverage+=1"),TEXT("journal:I kept the carbon but left registration active. Listed families remain exposed to placement orders.")}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("remedy_protect");S.Next=TEXT("syracuse_after");
S.Beats.Add({TEXT("mercer"),TEXT("I will mark those files withdrawn. Do not tell Elena I solved this. Her husband is still missing."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("remedy_destroy");S.Next=TEXT("syracuse_after");
S.Beats.Add({TEXT("mercer"),TEXT("The stove is hot enough. I will say the pipe burst. Tomas's wife still has the tag; do not let anyone take that from her."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("remedy_keep");S.Next=TEXT("syracuse_after");
S.Beats.Add({TEXT("mercer"),TEXT("Then understand what you are leaving in their hands. An open file is not a disguise for the families written in it."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("syracuse_after");S.Next=TEXT("rome_arrive");
S.Beats.Add({TEXT("lena"),TEXT("Rome is where several emergency consignments vanished from my ledger. I can explain that part to Voss. Nothing I have says who gave the order."),{TEXT("!dead_lena")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mara"),TEXT("Lena would have known the ledger. We have her copies and a family willing to put names to one transfer. That is enough to ask a real question."),{TEXT("dead_lena"),TEXT("!dead_mara")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("elena"),TEXT("If you find Tomas, tell him Luis still puts his shoes by the heater. He says we should be ready when his dad comes home."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mara"),TEXT("I want Canada. I have not changed my mind. But I will not step over these people on the way to it."),{TEXT("!dead_mara")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("samir"),TEXT("I sent word ahead to the canal crews. Bellwether will hear from us, too. You do not have to disappear to travel north."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("clinic_quiet");S.Next=TEXT("");
S.Beats.Add({TEXT("samir"),TEXT("You can sit. Nobody has a form for sitting."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("samir"),TEXT("Father wrote back. Three pages about the heater bearing. Two lines about himself. I am choosing to call that good news."),{TEXT("parcel_delivered"),TEXT("!dead_ivo")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("samir"),TEXT("I kept the parcel. I know he meant to bring it himself."),{TEXT("parcel_delivered"),TEXT("dead_ivo")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),1.2f});
S.Beats.Add({TEXT("samir"),TEXT("The clinic will be here when you need it. Bring clean water if you have some. Bring yourself even if you do not."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("rome_intro");S.Next=TEXT("rome_crew");
S.Beats.Add({TEXT("della"),TEXT("If you are here for a ride, get in line. If you are here for Tomas, come here."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("della"),TEXT("That tag is ours. We loaded the sealed consignments. I did not see the people inside until the third run. Then the Directorate stopped letting my crews near their wagons."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("lena"),TEXT("The same dispatch number appears on my emergency ledger. You were being paid with diverted public stock."),{TEXT("!dead_lena")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("della"),TEXT("Paid? They brought antibiotics. My crane operator was dying. I am not proud enough to call that easy."),{},TEXT("point"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("della"),TEXT("We need the terminal working to reach the northern station. Hank has the switch key. He wants his stranded cargo released before he puts his crew under another suspended load. Talk to him. Then lock the crane, drain the lift pit, and test the gate. In that order."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT(""),TEXT("Della's maintenance instructions survive at the dispatch desk. The crews will need a new agreement; her death has not made the machinery safer."),{TEXT("dead_della")},TEXT(""),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("hank_terms");S.Next=TEXT("");
S.Beats.Add({TEXT("hank"),TEXT("The crate with the green strap belongs to three farms. Della has it under lien. They miss the planting window, we miss meals."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("della"),TEXT("They owe us two engine rebuilds. If debts vanish whenever someone needs the cargo, I cannot keep crews fed."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Release the farm cargo against a written labor schedule."),TEXT("hank_shared"),TEXT(""),{},{TEXT("crew_ready"),TEXT("farm_schedule"),TEXT("trust_della+=1"),TEXT("freehold_supply+=1")}});
S.Choices.Add({TEXT("Pay the 80-credit lien. The cargo goes free."),TEXT("hank_paid"),TEXT(""),{TEXT("credits>=80")},{TEXT("spend:80"),TEXT("crew_ready"),TEXT("freehold_supply+=1"),TEXT("trust_hank+=2")}});
S.Choices.Add({TEXT("Back Della: cargo remains until the debt is worked."),TEXT("hank_lien"),TEXT(""),{TEXT("!dead_della")},{TEXT("crew_ready"),TEXT("toll_debt"),TEXT("trust_della+=2"),TEXT("trust_hank-=2")}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("hank_shared");S.Next=TEXT("rome_repair");
S.Beats.Add({TEXT("hank"),TEXT("I will put my name on the schedule. Put hers beside it. Nobody gets to pretend a signature only binds the poor."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("della"),TEXT("Fine. Two crews, three days. Here is the key."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("hank_paid");S.Next=TEXT("rome_repair");
S.Beats.Add({TEXT("della"),TEXT("Eighty clears it. You should have asked which of those farms can pay you back."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("hank"),TEXT("They can feed people. Some debts ought to stay that simple."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("hank_lien");S.Next=TEXT("rome_repair");
S.Beats.Add({TEXT("hank"),TEXT("Then I work. You can tell those farmers why."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("della"),TEXT("I will tell them myself. We keep a terminal or lose all three farms next winter."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("cargo_open");S.Next=TEXT("rome_control");
S.Beats.Add({TEXT("hank"),TEXT("The lock is cut. That is clothing, not machine packing."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT(""),TEXT("Among the bags: a water-board identification card for Tomas Paredes, a blue child's glove labeled LUIS, and a ring engraved R + S. The bags have processing tags. They were removed from travelers."),{},TEXT(""),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("della"),TEXT("I know two of those names. We are not selling this lot. Photograph the tags and put every bag back in its own sack."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("lena"),TEXT("The weights in my ledger make sense now. They called the belongings surplus, so nobody had to record a person losing them."),{TEXT("!dead_lena")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("rome_vote");S.Next=TEXT("");
S.Beats.Add({TEXT("della"),TEXT("Northbound freight can move again. The question is who signs a load out. One desk is quick. Three desks catch a mistake. Three desks can also spend a week arguing while medicine spoils."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("hank"),TEXT("A crew seat, a farm seat, her seat. Recorded tariffs. That is what I want."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("della"),TEXT("Or hand the keys to Corwin. He has asked often enough. He would open the gates and run out of spares before the thaw."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Della controls dispatch, with a public tariff ledger."),TEXT("rome_della"),TEXT(""),{TEXT("!dead_della")},{TEXT("canal_control=1"),TEXT("logistics=2"),TEXT("trust_della+=2"),TEXT("canal_prices=2")}});
S.Choices.Add({TEXT("Negotiate shared dispatch: crews, farms, and Della each hold a key."),TEXT("rome_shared"),TEXT(""),{},{TEXT("canal_control=2"),TEXT("logistics=1"),TEXT("coalition+=1"),TEXT("canal_prices=1")}});
S.Choices.Add({TEXT("Give Hank and the cargo owners control. Remove the toll desk."),TEXT("rome_hank"),TEXT(""),{},{TEXT("canal_control=3"),TEXT("logistics=1"),TEXT("trust_della-=3"),TEXT("canal_prices=0"),TEXT("spares_shortage")}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("rome_della");S.Next=TEXT("guard_arrive");
S.Beats.Add({TEXT("della"),TEXT("You will pay the published price like everyone else. But a medical wagon never waits behind luxury cargo. Write that first."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("hank"),TEXT("I will keep a second copy of the ledger. You can count on that."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("rome_shared");S.Next=TEXT("guard_arrive");
S.Beats.Add({TEXT("della"),TEXT("Hank takes nights. Farms appoint someone who can count. If this deadlocks, all three of us answer for it."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("hank"),TEXT("Fair. You have a seat at the table when it does, traveler. Not ownership of it."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("rome_hank");S.Next=TEXT("guard_arrive");
S.Beats.Add({TEXT("hank"),TEXT("Gate opens tonight. First run carries food, nobody pays to get their own blankets back."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("della"),TEXT("The spare parts will not arrive out of gratitude. Remember I said that when the winch stops."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("guard_intro");S.Next=TEXT("guard_convoy");
S.Beats.Add({TEXT("rook"),TEXT("Captain Elias Rook. The ward is through there. Keep your voice down; they have finally slept."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("imani"),TEXT("We hold the supply corridor. It is why the clinic has oxygen. It is also why I need two more drivers than I have."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("rook"),TEXT("Directorate medicines keep this hospital open. They ask us to escort their transfers. You have questions about one. Help Imani check the next convoy. Stay with the patients, and do not let a rifle settle a paperwork dispute."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("convoy_restraints");S.Next=TEXT("");
S.Beats.Add({TEXT("tomas"),TEXT("Do not close that door. My hands are tied to the seat."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("imani"),TEXT("Driver, where is the medical restraint order? ...That is a cargo receipt."),{},TEXT("point"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("tomas"),TEXT("They said Elena and Luis were following. Nobody will tell me where they are."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("rook"),TEXT("I am halting the movement. Sergeant, check every transport. Nobody leaves until we know who authorized this."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Unfasten the restraint and move Tomas to the ward."),TEXT("convoy_release"),TEXT(""),{},{TEXT("tomas_released"),TEXT("trust_imani+=2"),TEXT("evidence_restraints")}});
S.Choices.Add({TEXT("Keep the transport intact and copy the holding-facility route."),TEXT("convoy_follow"),TEXT(""),{},{TEXT("transport_traced"),TEXT("evidence_restraints"),TEXT("trust_tomas-=1")}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("convoy_release");S.Next=TEXT("guard_holding");
S.Beats.Add({TEXT("tomas"),TEXT("My ring is at home. Tell her that if she does not believe it is me."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("imani"),TEXT("I will book him as a patient under my own name. Whatever command thinks of that, it will have to say to me."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("convoy_follow");S.Next=TEXT("guard_holding");
