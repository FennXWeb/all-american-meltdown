V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("offer_open");S.Next=TEXT("");
S.Beats.Add({TEXT("richardson"),TEXT("Please. The coffee is fresh. You have spent a great deal of time among people who cannot offer that without giving something up."),{},TEXT("speak"),TEXT(""),FVector(0.0,350.0,0.0),1.0f});
S.Beats.Add({TEXT("richardson"),TEXT("Your arrival was expected. Keene's office kept me informed."),{TEXT("meridian_entry=1")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("You negotiated your way to the door. I prefer a person who knows what their information is worth."),{TEXT("meridian_entry=2")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("The maintenance supervisor noticed an extra worker. We will leave the question of whose idea that was for later."),{TEXT("meridian_entry=3")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("You entered through a service gate. You are now in a guarded room because I requested a conversation instead of an arrest."),{TEXT("meridian_entry=4")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("Bellwether. A shortage of fuel. A heater you chose to keep running. People remember the person who makes a cold room warm."),{TEXT("heat>=1"),TEXT("registration=1")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("Keene sent me the clinic referral. You understand that medicine delivered today persuades more reliably than a promise about next year."),{TEXT("aid_received")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("I do not need you because you are unique. I need you because people let you through their doors. I can offer food, secure transport, a medical allocation, and regional authority. In return, independent armed networks become part of one administration."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Ask about the people forbidden to leave."),TEXT("offer_labor"),TEXT(""),{},{}});
S.Choices.Add({TEXT("Ask about the ceasefire he rejected in 2028."),TEXT("offer_ceasefire"),TEXT(""),{},{}});
S.Choices.Add({TEXT("Ask what he expects you to do to your allies."),TEXT("offer_cost"),TEXT(""),{},{}});
S.Choices.Add({TEXT("Give your answer."),TEXT("offer_answer"),TEXT(""),{},{}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("offer_labor");S.Next=TEXT("");
S.Beats.Add({TEXT("richardson"),TEXT("I cannot operate a water plant with everyone free to leave their shift at once."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("vera"),TEXT("Their children lose housing if they refuse the shift. They surrendered their identities. That is not a scheduling problem."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("It is coercion. A government uses it. The question is whether it builds something that lasts. I will not flatter you by pretending otherwise."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Return to the offer."),TEXT("offer_open"),TEXT(""),{},{}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("offer_ceasefire");S.Next=TEXT("");
S.Beats.Add({TEXT("richardson"),TEXT("They demanded my surrender in exchange for a pause they could end whenever it suited them."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("I chose to preserve a national government. Millions died while I made that choice. You want an admission? There it is. You still have to decide who can keep the next million alive."),{},TEXT("point"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("vera"),TEXT("The personnel who stopped your next launch kept people alive without preserving your command."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("And now you are standing in the part they did not build."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Return to the offer."),TEXT("offer_open"),TEXT(""),{},{}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("offer_cost");S.Next=TEXT("");
S.Beats.Add({TEXT("richardson"),TEXT("Names, routes, meeting places. Then disarmament, incorporation, and removal of leaders who organize violent refusal. Registration. Consolidation. Removal. Project Inheritance is a sequence, not a slogan."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("You will not be asked merely to smile beside a flag. If you accept command, you will arrest people who trusted you. Some will refuse to submit. I expect you to carry out lawful sentences."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("Consider it carefully. A reluctant signature is of no use to either of us."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Give your answer."),TEXT("offer_answer"),TEXT(""),{},{}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("offer_answer");S.Next=TEXT("");
S.Beats.Add({TEXT("richardson"),TEXT("I have explained the position. Ask for time if you need it. Do not agree to a responsibility you intend to pretend was unclear."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Refuse. People are not his property."),TEXT("offer_refuse"),TEXT("coalition_table"),{},{TEXT("resistance")}});
S.Choices.Add({TEXT("Accept a provisional commission. Review the first order before any commitment to violence."),TEXT("offer_provisional"),TEXT("terms"),{},{TEXT("provisional"),TEXT("directorate_access"),TEXT("leverage+=1")}});
S.Choices.Add({TEXT("Feign acceptance to expose the transfer system, without promising an execution."),TEXT("offer_deception"),TEXT("terms"),{TEXT("insider_access")},{TEXT("double_agent"),TEXT("directorate_access"),TEXT("suspicion+=1")}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("offer_refuse");S.Next=TEXT("");
S.Beats.Add({TEXT("richardson"),TEXT("Then leave by the guest route while it is still available to you. The escort will make sure you do. I do not intend to keep offering the same terms."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("offer_provisional");S.Next=TEXT("");
S.Beats.Add({TEXT("richardson"),TEXT("Review it. I prefer useful agreement to theatrical loyalty. Keene's office will show you what regional authority can accomplish."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("offer_deception");S.Next=TEXT("");
S.Beats.Add({TEXT("richardson"),TEXT("You are careful about promises. I respect that. I will be equally careful about what access you receive."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("coalition");S.Next=TEXT("");
S.Beats.Add({TEXT("della"),TEXT("I can move freight and repair the route. I cannot promise a clean fight. Ask somebody who commands one."),{TEXT("!dead_della")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("rook"),TEXT("I can coordinate units and issue a credible stand-down instruction. They will need proof and a place to surrender."),{TEXT("rook_cooperates"),TEXT("!dead_rook")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("imani"),TEXT("The guard I command answers to the ward and the corridor communities. We will not trade one private chain of command for another."),{TEXT("imani_leads")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("hannah"),TEXT("I can get families through the woods. Put a marching column on that route and you will lose both the cover and the families."),{TEXT("!dead_hannah")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("ada"),TEXT("Extraction, decoys, the last vehicle out. Do not assign me a heroic final stand. I have spent too long learning why it is a bad plan."),{TEXT("!dead_ada")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mara"),TEXT("I take the wounded. I do not choose who deserves treatment by their uniform."),{TEXT("mara_returns"),TEXT("!dead_mara")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("imani"),TEXT("The hospital guard has splintered since Rook died. I can provide medics and a small escort. I will not promise the units that left."),{TEXT("guard_fragmented")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("hannah"),TEXT("I will get families out. That does not make us friends again. The people you sent to the Directorate are still missing."),{TEXT("defected"),TEXT("!dead_hannah")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT(""),TEXT("Absent seats remain empty. The surviving representatives divide the work they actually know; no one inherits a dead leader's experience."),{},TEXT(""),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Agree to a joint relief council with public accounts and divided keys."),TEXT("keys_shared"),TEXT(""),{},{TEXT("postwar_control=0"),TEXT("coalition+=1"),TEXT("support+=2")}});
S.Choices.Add({TEXT("Give the Lockkeepers central control of supply distribution."),TEXT("keys_della"),TEXT(""),{TEXT("!dead_della"),TEXT("trust_della>=0")},{TEXT("postwar_control=1"),TEXT("logistics+=1"),TEXT("support+=1")}});
S.Choices.Add({TEXT("Give the Civic Guard emergency authority over supplies and security."),TEXT("keys_guard"),TEXT(""),{TEXT("guard_support")},{TEXT("postwar_control=2"),TEXT("guard_support+=1"),TEXT("support+=1")}});
S.Choices.Add({TEXT("Put the Freeholds in charge of food and local access, without a central council."),TEXT("keys_freehold"),TEXT(""),{TEXT("!dead_hannah"),TEXT("trust_hannah>=0")},{TEXT("postwar_control=3"),TEXT("winter_food+=1"),TEXT("support+=1")}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("keys_shared");S.Next=TEXT("prisoner_plan");
S.Beats.Add({TEXT("imani"),TEXT("Then put the rules on paper before we have a building worth arguing over. Two signatures to release reserves, no family loses food for refusing a job."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("keys_della");S.Next=TEXT("prisoner_plan");
S.Beats.Add({TEXT("della"),TEXT("A ledger, a timetable, and a single dispatch desk. It will work. People will also have to ask us before they move what they need."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("keys_guard");S.Next=TEXT("prisoner_plan");
S.Beats.Add({TEXT("imani"),TEXT("An emergency mandate needs an end date. If the guard will not sign that date, people will have reason to fear what we built."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("keys_freehold");S.Next=TEXT("prisoner_plan");
S.Beats.Add({TEXT("hannah"),TEXT("Food stays with the communities that raise it. I will not pretend that makes every village generous. We will have our own arguments to answer for."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("terms");S.Next=TEXT("");
S.Beats.Add({TEXT("keene"),TEXT("Your commission clears supply requisitions and commands one regional detachment. It does not give you the president's personal troops."),{TEXT("!dead_keene")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("The first order is to identify the opposition's gathering place and deliver an incorporation demand. Review the personnel roster and reserve allocation. You are holding authority now, not merely being shown it."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("vera"),TEXT("If you are going to turn on this system, these are the transport codes. You can evacuate the people on the next list instead of delivering them. That will cost your disguise."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Audit the detachment roster and keep an independent reserve allocation."),TEXT("terms_leverage"),TEXT(""),{},{TEXT("loyal_personnel"),TEXT("reserve_control"),TEXT("leverage+=2"),TEXT("support+=1")}});
S.Choices.Add({TEXT("Leave personnel and reserves entirely under Richardson's control."),TEXT("terms_dependent"),TEXT(""),{},{TEXT("leverage=0"),TEXT("support=0")}});
S.Choices.Add({TEXT("Use the codes to evacuate the targeted households; expose the deception now."),TEXT("terms_defect"),TEXT("coalition_table"),{},{TEXT("resistance"),TEXT("double_exposed"),TEXT("civilian_rescues+=2"),TEXT("loyalist=0"),TEXT("suspicion+=3")}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("terms_leverage");S.Next=TEXT("necessary_measures");
S.Beats.Add({TEXT("richardson"),TEXT("You want a command that can function without asking permission for every crate. Sensible. I will hold you responsible for it."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("terms_dependent");S.Next=TEXT("necessary_measures");
S.Beats.Add({TEXT("richardson"),TEXT("Then requests come through this office. Keep the chain intact and it will keep you supplied."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("terms_defect");S.Next=TEXT("");
S.Beats.Add({TEXT("vera"),TEXT("The families are moving. They will know who opened the gate, even if nobody at your old meetings trusts you yet."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("commitment");S.Next=TEXT("");
S.Beats.Add({TEXT("richardson"),TEXT("The community will surrender its weapons, register every household, and accept appointed leadership. You will arrest the people who organize refusal. If you use their trust to bring them here, you will not be permitted to set them free afterward."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("This is the commitment. You may resign the commission before you carry it out. Afterward, do not call yourself an observer."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Carry out incorporation and the arrests. I understand this betrays the community."),TEXT("commit_loyal"),TEXT("loyal_hunt"),{},{TEXT("loyalist"),TEXT("betrayal_committed"),TEXT("trust_mara-=8"),TEXT("trust_hannah-=8"),TEXT("civilian_harm+=2")}});
S.Choices.Add({TEXT("Resign and take the order to the resistance."),TEXT("commit_resist"),TEXT("coalition_table"),{},{TEXT("resistance"),TEXT("loyalist=0"),TEXT("defected"),TEXT("evidence_order")}});
S.Choices.Add({TEXT("Warn the community and falsify the departure count; accept that this exposes me."),TEXT("commit_double"),TEXT("coalition_table"),{TEXT("double_agent")},{TEXT("resistance"),TEXT("loyalist=0"),TEXT("double_exposed"),TEXT("civilian_rescues+=2"),TEXT("evidence_order")}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("commit_loyal");S.Next=TEXT("");
S.Beats.Add({TEXT("richardson"),TEXT("Then proceed. Your detachment will follow a clear order. Make certain you give one."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("commit_resist");S.Next=TEXT("");
S.Beats.Add({TEXT("richardson"),TEXT("You have seen what we can preserve. Remember that when you choose what to destroy."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("commit_double");S.Next=TEXT("");
S.Beats.Add({TEXT("vera"),TEXT("The departure count buys an hour. I have already told the families what that hour is for. Now go before Keene checks the gate."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("evacuation_orders");S.Next=TEXT("resistance_exit");
S.Beats.Add({TEXT("vera"),TEXT("They move the labor families tonight. The service exit you prepared is still clear. Open it before you touch the security office."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("hannah"),TEXT("I marked a route that keeps them out of the vehicle yard. Walk the first group to the shelter marker. The rest will follow people, not a shouted coordinate."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mara"),TEXT("I will take anyone who cannot walk. Do not send them down a stairwell and call them evacuated."),{TEXT("mara_returns"),TEXT("!dead_mara")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("standdown");S.Next=TEXT("");
S.Beats.Add({TEXT("imani"),TEXT("We have the signed order and a place to process surrender. Their lieutenant has asked who guarantees his people will not be shot after they put their rifles down."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("rook"),TEXT("I will give that guarantee in my own name, under the ward's authority."),{TEXT("rook_cooperates"),TEXT("!dead_rook")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("imani"),TEXT("If Rook is not speaking for us, the civilian relief roster can. It has to be more than a threat with a polite ending."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Transmit the verified orders and the signed surrender guarantee."),TEXT("standdown_yes"),TEXT(""),{TEXT("evidence_authentication"),TEXT("guard_support")},{TEXT("unit_surrender"),TEXT("defections+=1")}});
S.Choices.Add({TEXT("Use the public evidence and an independently witnessed guarantee."),TEXT("standdown_yes"),TEXT(""),{TEXT("evidence_public"),TEXT("evidence_secured")},{TEXT("unit_surrender"),TEXT("defections+=1")}});
S.Choices.Add({TEXT("They will not accept our guarantee. Fight through the security line."),TEXT(""),TEXT("resistance_line"),{},{TEXT("security_fight")}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("standdown_yes");S.Next=TEXT("winter_stores");
S.Beats.Add({TEXT("imani"),TEXT("Rifles down. Keep the lane open. They are walking out. Nobody settles a private score in this line."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("winter_plan");S.Next=TEXT("");
S.Beats.Add({TEXT("della"),TEXT("Those tanks feed kitchens, not just generators. That warehouse is seed and medicine. Blow the compound open from this side and there is no clever way to unburn it."),{TEXT("!dead_della")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("vera"),TEXT("The isolation valves can cut the hall defense feed without cutting the refrigeration. The manual bypass is slower. Either saves the stores."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Isolate the defense feed and preserve the winter reserves."),TEXT(""),TEXT("winter_secure"),{},{TEXT("preserve_stores")}});
S.Choices.Add({TEXT("Open a demolition breach through the reserve block. The food and medicine will be lost."),TEXT("winter_loss"),TEXT(""),{},{TEXT("reserves_lost"),TEXT("civilian_losses+=2")}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("winter_loss");S.Next=TEXT("meridian_assault");
S.Beats.Add({TEXT("vera"),TEXT("Then we evacuate the store crews first. The people who survive the battle will still have to survive the winter you just made harder."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("assault_approach");S.Next=TEXT("meridian_inside");
S.Beats.Add({TEXT("hannah"),TEXT("Storm is covering the service ridge. Small groups on my markers. Keep the wounded route separate."),{TEXT("!dead_hannah"),TEXT("wilderness_routes")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("della"),TEXT("Freight diversion is moving. You have the maintenance approach until they notice the second truck is empty."),{TEXT("!dead_della"),TEXT("logistics")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("imani"),TEXT("Use the covered entrance. Civilians to the refuge rooms. Anyone who lays down a weapon goes to the surrender point."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT(""),TEXT("The approach remains possible without allied guides, but the exposed lane has no diversion."),{},TEXT(""),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("keene_decision");S.Next=TEXT("");
S.Beats.Add({TEXT("keene"),TEXT("You have reached the inhabited sector. The families here are not a shield I intend to die behind."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("keene"),TEXT("I implemented the lists. I signed transfers. I will not tell you I never knew. I can order my detachment off the family corridor. Tell me what happens after."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Surrender to civilian custody. Give the stand-down order and face an inquiry."),TEXT("keene_custody"),TEXT(""),{},{TEXT("keene_captured"),TEXT("unit_surrender"),TEXT("civilian_rescues+=1")}});
S.Choices.Add({TEXT("Help evacuate the families, then surrender with your detachment."),TEXT("keene_help"),TEXT(""),{TEXT("prisoner_roster")},{TEXT("keene_defects"),TEXT("civilian_rescues+=2")}});
S.Choices.Add({TEXT("Refuse his terms and fight his detachment."),TEXT(""),TEXT("keene_fight"),{},{TEXT("keene_fights")}});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("keene_custody");S.Next=TEXT("carrier_hall");
S.Beats.Add({TEXT("keene"),TEXT("I will transmit it on the open channel. You will have my voice on the order. Keep it for the inquiry."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("keene_help");S.Next=TEXT("carrier_hall");
S.Beats.Add({TEXT("keene"),TEXT("I know which gate leads to the school. Put someone beside me who will stop me if I turn the wrong way."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("carrier_reveal");S.Next=TEXT("carrier_battle");
S.Beats.Add({TEXT("richardson"),TEXT("You restored a canal terminal, and now you intend to dismantle the government that can supply it."),{TEXT("terminal_working")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("You kept the household files active. You understood their value when they opened a door for you."),{TEXT("registration_active")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("richardson"),TEXT("The carrier contains a functioning command office. It can leave this hall while you argue over who gets the warehouses. Stand down."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("imani"),TEXT("Its escorts keep the service controls covered. The hall shutters and external feed give it overlapping defenses. Break either system and the other still works."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
