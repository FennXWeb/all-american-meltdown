{FLWC76Scene S;S.Id=TEXT("world_records");S.Next=TEXT("canada_decide");
S.Beats.Add({TEXT("chen"),TEXT("These are independent broadcast archives, intercepted warning records, and relief reports. None alone tells the whole story. Start with the dates."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.8f});
S.Beats.Add({TEXT(""),TEXT("SEPTEMBER 2028: foreign target reports record attempted American launches that failed to reach their targets. Independently timed imagery records subsequent attacks on American cities. The sequence is corroborated; individual decisions abroad remain incompletely documented."),{},TEXT(""),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT(""),TEXT("A dated ceasefire channel required Richardson's surrender. The acknowledgement tape rejects those terms and orders the preservation of continuity personnel. Separate command testimony records officers preventing another outward escalation."),{},TEXT(""),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("simon"),TEXT("That is the acknowledgement I heard. Not a man on television claiming it later. The reply on our circuit that night."),{TEXT("testimony"),TEXT("!dead_simon"),TEXT("!witness_surrendered")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.8f});
S.Beats.Add({TEXT("lena"),TEXT("The emergency-stock transfers started before the attacks. I can match the requisition signatures to the continuity compounds. They chose who would have supplies."),{TEXT("!dead_lena")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.8f});
S.Beats.Add({TEXT("chen"),TEXT("A recent Meridian medical requisition bears the same live authentication chain. A defector identifies Richardson in a current secure attendance record. With the earlier evidence, we can say he survived. We cannot say he controlled every event that followed."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.8f});
S.Beats.Add({TEXT("mara"),TEXT("He let a country burn rather than surrender himself. And now he has lists of who gets a room in the part he kept."),{TEXT("!dead_mara")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),1.3f});
V.Add(MoveTemp(S));}
{FLWC76Scene S;S.Id=TEXT("canada_choice");S.Next=TEXT("");
S.Beats.Add({TEXT("mara"),TEXT("I am safe here. I need you to hear that before you ask what comes next. I can go a day without deciding who gets the last sterile needle."),{TEXT("!dead_mara")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("chen"),TEXT("You may remain. You may return. Neither decision changes your right to a bed here. We cannot send an army south with you."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Beats.Add({TEXT("mara"),TEXT("If you go back, give me an honest job and an honest way out. Do not ask me to call every sacrifice worthwhile."),{TEXT("!dead_mara")},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
S.Choices.Add({TEXT("Stay in Canada. Build a life on this shore."),TEXT("other_shore"),TEXT("ending_other"),{},{TEXT("remain_canada"),TEXT("ending_other"),TEXT("journal:I chose to remain in Canada. Safety did not require another war.")}});
