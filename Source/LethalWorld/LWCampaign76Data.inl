S.Choices.Add({TEXT("Return and ask Mara to help with medical evacuation, with a guaranteed way back."),TEXT("return_mara_joins"),TEXT("homecoming"),{TEXT("!dead_mara"),TEXT("trust_mara>=1")},{TEXT("return_chosen"),TEXT("mara_returns"),TEXT("evidence_secured"),TEXT("humanitarian_permit")}});
S.Choices.Add({TEXT("Return to investigate Richardson's offer of power."),TEXT("return_ambition"),TEXT("homecoming"),{},{TEXT("return_chosen"),TEXT("mara_stayed"),TEXT("ambition"),TEXT("evidence_secured"),TEXT("humanitarian_permit")}});
