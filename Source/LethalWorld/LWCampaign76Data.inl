{FLWC76Scene S;S.Id=TEXT("freehold_table");S.Next=TEXT("");
S.Beats.Add({TEXT("orrin"),TEXT("Forty sacks until thaw. Twenty-three mouths already. You bring nine more, you have thirty-two people hungry later."),{},TEXT("speak"),TEXT(""),FVector(0.0,0.0,0.0),0.0f});
