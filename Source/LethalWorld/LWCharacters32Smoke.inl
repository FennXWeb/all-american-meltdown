 Add(TEXT("PS2 male creator"),3,[this,G](ALWCharacter& P){P.NewGame();P.RPG.Story.Enabled=false;G->Scene=GetWorld()->SpawnActor<ALWOpeningScene>(FVector(0,0,80000),FRotator::ZeroRotator);G->Scene->World=P.World;P.OpeningScene=G->Scene;P.OpeningMode=2;P.DraftIdentity=FLWIdentity();P.DraftIdentity.Hair=2;G->Scene->Portrait(P.DraftIdentity,0);Cast<APlayerController>(P.Controller)->SetViewTarget(G->Scene);P.bMenu=true;P.SetMenuInput(true);for(auto& C:G->Scene->Pieces)Check(C&&C->GetStaticMesh(),TEXT("creator has valid model components"));},[this](ALWCharacter& P){CaptureV2(TEXT("Characters32_MaleCreator"));});
