 Add(TEXT("locked container authorization"),1,[this,S](ALWCharacter& P){LWV2Teleport(P,FVector(2000,-340,115));S->Box=P.World->SpawnObject(ELWObjectKind::Container,TEXT("v5_locked_box"),FVector(2050,-440,0));auto& R=P.World->Containers.FindOrAdd(S->Box->RecordId);R.Id=S->Box->RecordId;R.Position=S->Box->GetActorLocation();R.LockTier=4;R.Unlocked=false;P.OpenContainer(S->Box.Get());Check(P.SecurityMode==1&&!P.bInventory&&!P.CanAct(),TEXT("locked storage starts picking and blocks inventory/combat"));Check(P.ItemsFor(2)==nullptr,TEXT("locked storage has no accessible inventory panel"));Check(P.SecurityTier==4,TEXT("master lock tier selected"));},[this](ALWCharacter&){CaptureV2(TEXT("02_Lockpick"));});
 Add(TEXT("pick wear and breaking"),.2,[this,S,Torque](ALWCharacter& P){P.PickAngle=P.LockSecret>0?-90:90;P.PickHealth=.1f;S->Picks=P.CountSupply(TEXT("lockpick"));Torque(P,true);for(int I=0;I<40&&P.SecurityMode;I++)P.TickSecurity(.05f);Torque(P,false);Check(P.SecurityMode==0&&P.CountSupply(TEXT("lockpick"))==S->Picks-1,TEXT("binding breaks exactly one pick"));Check(P.World->Containers.FindChecked(S->Box->RecordId).LockAttempts==1&&P.IsLocked(S->Box.Get()),TEXT("failed attempt stays locked and advances seed"));});
 Add(TEXT("successful real torque input"),.5,[this,S,Torque](ALWCharacter& P){Check(P.StartLockpick(S->Box.Get()),TEXT("retry with another pick"));P.PickAngle=P.LockSecret;Torque(P,true);for(int I=0;I<25&&P.SecurityMode;I++)P.TickSecurity(.05f);Torque(P,false);Check(!P.IsLocked(S->Box.Get())&&P.bInventory&&P.ItemsFor(2),TEXT("correct angle unlocks and opens loot grid"));P.ClosePanels();});
 Add(TEXT("tier loot and vehicle access"),.5,[this,S](ALWCharacter& P){int Locked=0;TSet<int> Tiers;for(const auto& C:P.World->Containers)if(C.Value.LockTier>0&&C.Key!=TEXT("v5_locked_box")){Locked++;Tiers.Add(C.Value.LockTier);FName Bonus=C.Value.LockTier==1?TEXT("ammo_12g"):C.Value.LockTier==2?TEXT("medkit"):C.Value.LockTier==3?TEXT("rifle"):TEXT("lmg");Check(C.Value.Items.ContainsByPredicate([&](const auto& I){return I.Definition==Bonus;}),TEXT("tier loot bonus present"));}Check(Locked>0&&Tiers.Num()>1,TEXT("procedural containers have mixed lock tiers"));
  auto Wrong=LWItems::Make(TEXT("car_key"));Wrong.VehicleId=FGuid::NewGuid();LWItems::Place(P.Inventory,Wrong,12,10);Check(!P.HasKey(S->VIN),TEXT("another car key cannot authorize this VIN"));S->Car->Use(&P);Check(P.SecurityMode==1&&!P.Vehicle,TEXT("locked car requires key or picking"));P.ClosePanels();auto Key=LWItems::Make(TEXT("car_key"));Key.VehicleId=S->VIN;S->Key=Key.Id;Check(LWItems::Place(P.Inventory,Key,12,10),TEXT("matching key fits inventory"));S->Car->Use(&P);Check(P.Vehicle==S->Car.Get()&&S->Car->Record()->Unlocked,TEXT("matching key opens driver seat"));P.Reload();Check(S->Car->EngineOn,TEXT("matching key starts engine"));P.Reload();P.Inventory.RemoveAll([&](const auto& I){return I.Id==S->Key;});
 });
