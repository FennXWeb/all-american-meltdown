 });
 Add(TEXT("glovebox inventory and lid"),1,[this,S](ALWCharacter& P){P.VehicleGlove();Check(P.bInventory&&P.OpenObject->RecordId==S->Car->GloveId(),TEXT("glovebox opens separate storage"));auto Key=LWItems::Make(TEXT("car_key"));Key.VehicleId=S->VIN;S->Key=Key.Id;auto& G=P.World->Containers.FindChecked(S->Car->GloveId());Check(LWItems::Place(G.Items,Key,6,4),TEXT("key fits glovebox"));Check(LWV2MoveAuto(P,2,0,S->Key)&&P.HasKey(S->VIN),TEXT("drag matching key out of glovebox"));Check(LWV2MoveAuto(P,0,2,S->Key)&&!P.HasKey(S->VIN),TEXT("stored key is not carried ignition authorization"));},[this,S](ALWCharacter&){Check(S->Car->GloveAngle>55,TEXT("glovebox lid physically opens"));CaptureV2(TEXT("04_Glovebox"));});
